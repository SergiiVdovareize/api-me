generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Request {
  id        Int      @id @default(autoincrement())
  apiType   Int
  createdAt DateTime @default(now())
}

model Account {
  id               Int               @id @default(autoincrement())
  createdAt        DateTime          @default(now())
  isActive         Boolean           @default(true)
  trackId          String            @unique
  type             AccountType
  title            String?
  description      String?
  accountIncomings AccountIncoming[]
}

model AccountIncoming {
  id        Int      @id @default(autoincrement())
  balance   Int
  trackedAt DateTime @default(now())
  accountId Int
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model GameResult {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  gameType  GameType
  name      String
  result    Int
}

model AlphadateBoard {
  id        Int                @id @default(autoincrement())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  key       String             @unique
  name      String?
  pin       String?
  email     String?
  settings         Json?              @default("{}")
  letters          Json?              @default("[]")
  partners         AlphadatePartner[]
  history          AlphadateHistory[]
  currentLetter           String?            @db.Char(1)
  currentLetterSelectedAt DateTime?
  currentPartnerId        Int?
  currentPartner          AlphadatePartner?  @relation("CurrentPartner", fields: [currentPartnerId], references: [id])
}


model AlphadatePartner {
  id             Int                @id @default(autoincrement())
  boardId        String
  board          AlphadateBoard     @relation(fields: [boardId], references: [key], onDelete: Cascade)
  name           String
  turnOrder      Int                @db.SmallInt
  playerId       Int?               @db.SmallInt
  history        AlphadateHistory[]
  currentInBoard AlphadateBoard[]   @relation("CurrentPartner")

  @@unique([boardId, turnOrder])
}

model AlphadateHistory {
  id          Int               @id @default(autoincrement())
  boardId     String
  board       AlphadateBoard    @relation(fields: [boardId], references: [key], onDelete: Cascade)
  partnerId   Int?
  partner     AlphadatePartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  letter      String            @db.Char(1)
  status      LetterStatus
  note        String?           @db.Text
  photo       String?           @db.Text
  selectedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  @@unique([boardId, letter])
}


enum LetterStatus {
  used
  skipped
  excluded
}

enum AccountType {
  mono
  privat
}

enum GameType {
  stroop
}

model HumanAssistSync {
  userId    String   @id @map("user_id") @db.VarChar(64)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("human_assist_sync")
}

enum PriceProductStatus {
  ACTIVE
  UNSUPPORTED
  ERROR
}

model PriceProduct {
  id                Int                @id @default(autoincrement())
  url               String             @unique
  domain            String
  title             String
  lastPrice         Float?
  currency          String             @default("UAH") @db.VarChar(10)
  inStock           Boolean            @default(true)
  status            PriceProductStatus @default(ACTIVE)
  targetPrice       Float?
  dropPercent       Float?
  notifyOnRestock   Boolean            @default(false)
  lastNotifiedPrice Float?
  chatId            String?            @default("1252877") @db.VarChar(64)
  selector          String?            @db.Text
  sizes             Json?              // e.g. ["XXS", "XS", "S", "M", "L"]
  colors            Json?              // e.g. ["світло-сірий", "чорний"]
  desiredSize       String?            @db.VarChar(32)
  desiredColor      String?            @db.VarChar(64)
  failCount         Int                @default(0)
  history           Json?              @default("[]")
  lastCheckedAt     DateTime?
  nextCheckAt       DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, nextCheckAt])
  @@index([domain])
}

