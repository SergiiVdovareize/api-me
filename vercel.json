{
    "version": 2,
    "github": {
      "enabled": false
    },
    "builds": [
      {
        "src": "dist/main.js",
        "use": "@vercel/node",
        "config": {
          "maxDuration": 60
        }
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "dist/main.js"
      }
    ]
  }